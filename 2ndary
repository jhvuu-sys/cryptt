local function styleToggle(btn, on)
    btn.Text = on and "ON" or "OFF"
    btn.BackgroundColor3 = on
        and Color3.fromRGB(35, 165, 89)
        or Color3.fromRGB(190, 60, 60)
end

local function createPanel()
    local gui = Instance.new("ScreenGui")
    gui.Name = "MarkerColorPanel"
    gui.ResetOnSpawn = false

    local success = pcall(function()
        gui.Parent = CoreGui
    end)
    if not success then
        gui.Parent = player:WaitForChild("PlayerGui")
    end

    mainGuiReference = gui  -- so the hotkey can hide / show the panels

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 230, 0, 388)
    frame.Position = UDim2.new(0, 20, 0.5, -194)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true  -- deprecated but still works; drag the panel anywhere
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -90, 0, 24)
    title.Position = UDim2.new(0, 10, 0, 8)
    title.BackgroundTransparency = 1
    title.Text = "Landing Marker"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 60, 0, 24)
    toggleBtn.Position = UDim2.new(1, -70, 0, 8)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 12
