-- Walk to ball (goes right onto its predicted landing spot)
---------------------------------------------------------------------
-- Where we want to stand: the predicted landing spot if there is one,
-- otherwise the ball itself (no prediction yet). Dead (landed) balls are ignored.
local function getGoal(data)
    if data.dead or data.straightDown then return nil end
    local part = getPart(data)
    if not part then return nil end
    if LOCK_LANDING then return data.landing end  -- wait for the locked spot instead of guessing
    return data.landing or part.Position
end

-- Returns the tracked ball whose goal point is closest and on the chosen side
local function findBall(skip)
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, data in pairs(balls) do
        local goal = getGoal(data)
        if goal and not (skip and skip[data]) then
            local offset = goal - root.Position
            offset = Vector3.new(offset.X, 0, offset.Z)  -- ignore height
            local dist = offset.Magnitude

            if dist > 0.1 and dist <= walkRange and dist < bestDist then
                local side = offset.Unit:Dot(root.CFrame.RightVector)  -- +1 = right, -1 = left
                local ok = walkSide == "Any"
                    or (walkSide == "Right" and side >= SIDE_THRESHOLD)
                    or (walkSide == "Left" and -side >= SIDE_THRESHOLD)
                if ok then
                    best, bestDist = data, dist
                end
            end
        end
    end
    return best
end

local function stopMoving()
    runId += 1
    if humanoid and root then
        humanoid:MoveTo(root.Position)  -- moving to where we already are cancels the walk
    end
end

-- Presses a key through VirtualInputManager (held briefly so the game registers it)
local function simulateKeyPress(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function walkTo(data)
    runId += 1
    local myId = runId
    activeTripId = myId
    local startTime = os.clock()
    local lastCommand = 0
    local lastSpamTime = 0
    local lastGoal  -- if the ball lands mid-trip, keep going to where it landed
    local actionFired = false

    local conn
    local function finish()
        conn:Disconnect()
        if activeTripId == myId then activeTripId = nil end
    end
    conn = RunService.Heartbeat:Connect(function()
        -- Cancelled, died, or the ball was removed
        if runId ~= myId or not humanoid or humanoid.Health <= 0 or not root or balls[data.inst] ~= data then
            finish()
            return
        end

        local goal = getGoal(data) or lastGoal
        if not goal then
            finish()
            return
        end
        lastGoal = goal

        local offset = goal - root.Position
        local flatDist = Vector3.new(offset.X, 0, offset.Z).Magnitude

        -- Continuous key / sprint spam loop while walking
        if SPAM_ENABLED and os.clock() - lastSpamTime >= SPAM_INTERVAL then
            lastSpamTime = os.clock()
            VirtualInputManager:SendKeyEvent(true, SPAM_KEY, false, game)
            task.spawn(function()
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, SPAM_KEY, false, game)
            end)
        end

        -- Close enough: face the target and press the action key
        if flatDist <= TRIGGER_DISTANCE and not actionFired then
            if FIRE_ONCE_PER_TRIP then
                actionFired = true
            end

            -- Snap orientation horizontally (yaw only) toward the target
            local lookTarget = Vector3.new(goal.X, root.Position.Y, goal.Z)
            root.CFrame = CFrame.lookAt(root.Position, lookTarget)

            task.spawn(simulateKeyPress, ACTION_KEY)  -- spawned so the key hold doesn't pause this loop
        end

        -- Arrived, or took too long
        if flatDist <= walkStop or os.clock() - startTime > GIVE_UP_TIME then
            finish()
            humanoid:MoveTo(root.Position)
            return
        end

        -- MoveTo expires after ~8 s and the goal keeps changing as the prediction updates,
        -- so re-issue it a few times per second
        if os.clock() - lastCommand > 0.25 then
            lastCommand = os.clock()
            humanoid:MoveTo(goal)
        end
    end)
end

-- Hold-to-walk: while the key (or the panel button) is held, keep walking to the nearest ball;
-- the moment it is released, stop.
local holdVisited = {}  -- balls already walked to during this hold, so we don't keep re-walking to one

local function beginHold(source)
    if holding or not walkEnabled then return end
    if not (humanoid and root) or humanoid.Health <= 0 then return end

    if not HOLD_TO_WALK then  -- tap mode: one trip per press
        local data = findBall()
        if data then walkTo(data) end
        return
    end

    holding = true
    holdSource = source
    table.clear(holdVisited)
end

local function endHold()
    if not holding then return end
    holding = false
    holdSource = nil
    stopMoving()  -- cancels the trip and halts the character
end

-- While held and not already walking, pick the next ball in range
RunService.Heartbeat:Connect(function()
    if not holding or activeTripId then return end
    if not walkEnabled or not (humanoid and root) or humanoid.Health <= 0 then return end

    local data = findBall(holdVisited)
    if data then
        holdVisited[data] = true
        walkTo(data)
    end
end)

-- `processed` is true while typing in the hex box, so pressing the key there will not start anything.
UserInputService.InputBegan:Connect(function(input, processed)
    -- Global hotkey to hide / show the UI
    if input.KeyCode == UI_TOGGLE_KEY then
        if toggleUi then toggleUi() end
        return
    end

    if listeningForKey then  -- the panel's Key button is waiting for a new key
        if input.UserInputType == Enum.UserInputType.Keyboard then
            listeningForKey = false
            if input.KeyCode ~= Enum.KeyCode.Escape then  -- Escape cancels
                triggerKey = input.KeyCode
            end
            if refreshKeyButton then refreshKeyButton() end
        end
        return
    end

    if processed or input.KeyCode ~= triggerKey then return end
    beginHold("key")
end)

-- Letting go of the key (or the panel button) stops everything right away
UserInputService.InputEnded:Connect(function(input)
    if not holding then return end
    if holdSource == "key" and input.KeyCode == triggerKey then
        endHold()
    elseif holdSource == "button" and (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
        endHold()
    end
end)

