---------------------------------------------------------------------
-- Settings: ball landing predictor & Action triggers
---------------------------------------------------------------------
local BALL_NAME = "Ball"          -- every Part or Model with this name is tracked AND is what E walks to
local MAX_BALLS = 10              -- safety cap on how many balls are tracked at once
local STEP = 1 / 30               -- simulation step (seconds)
local MAX_TIME = 6                -- how far ahead to predict (seconds)

local IGNORE_INVISIBLE = true     -- skip parts that are (nearly) transparent
local INVISIBLE_THRESHOLD = 0.95  -- Transparency at or above this counts as invisible

local SAMPLE_WINDOW = 0.25        -- seconds of recent movement used to smooth the ball's position/velocity
local MIN_SAMPLES = 4             -- need at least this many samples before trusting the smoothing
local RESET_ERROR = 0.75          -- studs off the predicted arc before old samples are thrown out (launch, bounce, hit)
local RECENCY_HALF_LIFE = 0.1     -- newer samples count more; every this many seconds an older sample counts half as much
local AUTO_GRAVITY = true         -- learn how this ball really falls (custom gravity / lift) from its own flight
local DEBUG = false               -- true = print the learned gravity scale (1 = normal Roblox gravity)
local SMOOTHING = 12              -- (only when LOCK_LANDING = false) landing marker smoothing
local SNAP_DISTANCE = 8           -- (only when LOCK_LANDING = false) landing jumps bigger than this snap instead of gliding
local USE_SPHERECAST = true       -- account for the ball's size instead of tracing only its center
local SPEED_DRAG_FACTOR = nil     -- manual: gravity scale = 1 - this * speed (e.g. 0.004 = 40% less gravity at 100 studs/s). nil = learn it automatically
local SCALE_FORGET = 0.999        -- how slowly old flights are forgotten while learning how speed changes the fall
local GRAVITY_OVERRIDE = nil      -- set a number to force the ball's gravity (turns AUTO_GRAVITY off)

local LOCK_LANDING = true         -- true = pick the landing spot ONCE, then keep it fixed; false = keep re-estimating (jittery)
local LOCK_AFTER = 0.06           -- seconds of clean flight to watch before locking (more = more accurate, but the marker appears later)
local LOCK_TOLERANCE = 5          -- studs the ball may drift from the locked path before the spot is re-picked (more = steadier)
local IGNORE_STRAIGHT_DOWN = true -- ignore balls that are only falling straight down (no marker, arc, highlight, or walking)
local STRAIGHT_DOWN_SPEED = 4     -- sideways speed (studs/s) below this counts as "straight down"
local STRAIGHT_DOWN_DISTANCE = 3  -- a predicted spot closer than this (sideways) to the ball is "right under it" and never locked
local STABLE_WINDOW = 0.06        -- the ball's velocity estimate must stay steady this long before locking (avoids locking on a half-updated estimate right after a hit)
local STABLE_TOLERANCE = 2        -- studs/s of wobble (plus 4% of the speed) still counted as "steady"
local USE_FACING = true           -- lock a first guess sooner by reading which way the nearest player is facing
local FACING_RANGE = 15           -- the nearest player within this many studs of the ball counts as the hitter
local FACING_CONE = 45            -- degrees: the hitter's facing line is trusted only if the ball is heading roughly that way (otherwise the ball's own direction is used)
local HITDIR_MAX_AGE = 1          -- seconds the hitter's facing (read just BEFORE the hit) stays usable
local AIM_SIDE_ALLOWANCE = 25     -- studs the ball may drift sideways off the facing line before a locked spot is dropped
local REFINE_DISTANCE = 2         -- when the steady estimate arrives, an early lock is replaced only if it was off by more than this (studs)
local USE_PREHIT = true           -- BEFORE a hit: if a player is under the ball, estimate the landing from where they face
local HITTER_RADIUS = 5           -- a player counts as "under the ball" within this sideways distance (studs)...
local HITTER_REACH = 12           -- ...and when the ball is no more than this far above them
local HITTER_MIDAIR_ONLY = true   -- true = only players who are in the air; false = standing players count too
local PREHIT_STEP = 4              -- the pre-hit estimate only moves when it changes by more than this (studs), so it stays steady
local DEFAULT_HIT_SPEED = 40      -- until real hits have been seen: typical sideways speed of a hit ball (studs/s)
local DEFAULT_HIT_VY = 25         -- ...and typical upward speed (studs/s)

local TOUCH_GAP = 0.3             -- a ball only counts as landed when its surface is this close to the floor (studs); merely being near is not enough
local FLOOR_REST_TIME = 0.15      -- ...or when it has stayed on the floor this long (rolling along it)

local ARC_STRIDE = 2              -- draw one segment per this many steps (higher = fewer parts)
local ARC_THICKNESS = 0.25
local ARC_TRANSPARENCY = 0.35
local ARC_DASHED = true           -- true = dashed line, false = solid

-- Virtual Action Settings (Key "3", Rotation Snap, & Continuous Sprint/Key Spam)
