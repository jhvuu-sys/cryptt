--- Combined LocalScript
--- 1) Press E (or click Walk Now in the panel): find the ball whose predicted landing spot is nearest
---    on the chosen side (Right / Left / Any) of the character, and walk right onto it
--- 2) Ball landing predictor: tracks every ball, marker + arc per ball, color panel, switches
---    (the walker reads the predictor's landing spots, so both share the same ball list)

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

---------------------------------------------------------------------
-- Settings: walk to ball (these are the defaults; the panel changes them live)
---------------------------------------------------------------------
local TRIGGER_KEY = Enum.KeyCode.E
local DETECT_RANGE = 40        -- how far away a ball's landing spot can be (studs)
local SIDE_THRESHOLD = 0.5     -- for Right / Left: 1 = exactly to the side, 0.5 = within ~60 degrees of it
local STOP_DISTANCE = 1        -- how close counts as "on top of it" (studs); 0 = keep going until timeout
local GIVE_UP_TIME = 8         -- stop trying after this many seconds

---------------------------------------------------------------------
-- Settings: ball landing predictor & Action triggers
---------------------------------------------------------------------
local BALL_NAME = "Ball"         -- every Part or Model with this name is tracked AND is what E walks to
local MAX_BALLS = 10             -- safety cap on how many balls are tracked at once
local STEP = 1 / 30               -- simulation step (seconds)
local MAX_TIME = 6               -- how far ahead to predict (seconds)

local IGNORE_INVISIBLE = true     -- skip parts that are (nearly) transparent
local INVISIBLE_THRESHOLD = 0.95  -- Transparency at or above this counts as invisible

local SAMPLE_WINDOW = 0.25        -- seconds of recent movement used to smooth the ball's position/velocity
local MIN_SAMPLES = 4             -- need at least this many samples before trusting the smoothing
local RESET_ERROR = 2             -- studs off the predicted arc before old samples are thrown out (bounce, hit, teleport)
local SMOOTHING = 12              -- landing marker smoothing (higher = snappier, lower = steadier)
local SNAP_DISTANCE = 8           -- landing jumps bigger than this snap instead of gliding
local USE_SPHERECAST = true       -- account for the ball's size instead of tracing only its center
local GRAVITY_OVERRIDE = nil      -- set a number if your ball falls differently from Workspace.Gravity

local DEAD_DISTANCE = 6          -- ball bounced within this many studs of its predicted landing spot = it landed
local LAND_TOUCH = 1              -- or it got this close (beyond its own radius) to the landing spot

local ARC_STRIDE = 2              -- draw one segment per this many steps (higher = fewer parts)
local ARC_THICKNESS = 0.25
local ARC_TRANSPARENCY = 0.35
local ARC_DASHED = true           -- true = dashed line, false = solid

-- Virtual Action Settings (Key "3", Rotation Snap, & Continuous Sprint/Key Spam)
local ACTION_KEY = Enum.KeyCode.Three
local TRIGGER_DISTANCE = 5      -- Distance (studs) from target to snap-look and press "3"
local FIRE_ONCE_PER_TRIP = true -- Prevents spamming "3" repeatedly on the same run

-- Continuous Spam / Sprint Settings during the walk phase
local SPAM_ENABLED = true       -- Set to false if you only want the single "3" key press
local SPAM_KEY = Enum.KeyCode.T -- Key to spam while walking
local SPAM_INTERVAL = 0.1       -- Time in seconds between each spam press

-- UI Toggle Hotkey Setting
local UI_TOGGLE_KEY = Enum.KeyCode.F4 -- Press F4 to completely hide/show all your UI panels

local PRESETS = {
    Color3.fromRGB(255, 70, 70),   -- red
    Color3.fromRGB(255, 160, 40),  -- orange
    Color3.fromRGB(250, 220, 60),  -- yellow
    Color3.fromRGB(60, 220, 100),  -- green
    Color3.fromRGB(70, 160, 255),  -- blue
    Color3.fromRGB(190, 100, 255), -- purple
}

---------------------------------------------------------------------
-- Shared state
---------------------------------------------------------------------
local humanoid, root              -- current character parts (walk-to-target)
local runId = 0                   -- changes on every new trip so old trips cancel themselves

local enabled = true              -- predictor master switch
local arcEnabled = true           -- predictor arc switch
local markerColor = PRESETS[1]

local walkEnabled = true          -- walking master switch (panel)
local walkRange = DETECT_RANGE    -- live values, changed from the panel
local walkStop = STOP_DISTANCE
local walkSide = "Right"          -- "Right", "Left" or "Any"
local triggerKey = TRIGGER_KEY
local listeningForKey = false     -- true while the panel is waiting for a new key
local refreshKeyButton            -- set by the panel so the key button can update its label
local mainGuiReference = nil      -- reference to the ScreenGui for hiding/showing

---------------------------------------------------------------------
-- Character binding (single handler for the whole script)
---------------------------------------------------------------------
local function bindCharacter(char)
    runId += 1  -- cancel any trip left over from the previous character
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")
end
bindCharacter(player.Character or player.CharacterAdded:Wait())
player.CharacterAdded:Connect(bindCharacter)

---------------------------------------------------------------------
-- Predictor: shared folders (one place for the raycast to ignore all visuals)
---------------------------------------------------------------------
local markerFolder = Instance.new("Folder")
markerFolder.Name = "LandingMarkers"
markerFolder.Parent = Workspace

local arcFolder = Instance.new("Folder")
arcFolder.Name = "TrajectoryArcs"
arcFolder.Parent = Workspace

local highlightFolder = Instance.new("Folder")
highlightFolder.Name = "BallHighlights"
highlightFolder.Parent = Workspace

---------------------------------------------------------------------
-- Predictor: per-ball tracking
---------------------------------------------------------------------
local balls = {}      -- [instance] = data table for that ball
local ballCount = 0

local function createMarker()
    local marker = Instance.new("Part")
    marker.Name = "LandingMarker"
    marker.Shape = Enum.PartType.Cylinder
    marker.Size = Vector3.new(0.15, 5, 5)
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanQuery = false
    marker.CanTouch = false
    marker.Material = Enum.Material.Neon
    marker.Color = markerColor
    marker.Transparency = 1
    marker.Parent = markerFolder
    return marker
end

local function createHighlight()
    local highlight = Instance.new("Highlight")
    highlight.FillColor = markerColor
    highlight.FillTransparency = 0.6
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.Parent = highlightFolder
    return highlight
end

local function addBall(inst)
    if balls[inst] then return end
    if inst.Name ~= BALL_NAME then return end
    if not (inst:IsA("BasePart") or inst:IsA("Model")) then return end
    if ballCount >= MAX_BALLS then return end

    local folder = Instance.new("Folder")
    folder.Name = "Arc"
    folder.Parent = arcFolder

    balls[inst] = {
        inst = inst,
        part = nil,
        landing = nil,  -- predicted landing position, read by the walker
        history = {},   -- recent { t, pos } samples used to smooth the motion
        fitPos = nil,   -- last smoothed position / velocity / time
        fitVel = nil,
        fitTime = nil,
        dead = false,   -- landed: ignored for good (no marker, arc, or walking)
        marker = createMarker(),
        highlight = createHighlight(),
        folder = folder,
        segments = {},  -- pooled arc parts for this ball
    }
    ballCount += 1
end

local function removeBall(inst)
    local data = balls[inst]
    if not data then return end
    data.marker:Destroy()
    data.highlight:Destroy()
    data.folder:Destroy()
    balls[inst] = nil
    ballCount -= 1
end

local function getPart(data)
    local part = data.part
    if part and part.Parent then return part end

    local inst = data.inst
    if inst:IsA("BasePart") then
        part = inst
    else
        part = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    data.part = part
    return part
end

for _, d in ipairs(Workspace:GetDescendants()) do
    addBall(d)
end
Workspace.DescendantAdded:Connect(addBall)
Workspace.DescendantRemoving:Connect(removeBall)

---------------------------------------------------------------------
-- Predictor: arc drawing (per ball)
---------------------------------------------------------------------
local function getSegment(data, index)
    local seg = data.segments[index]
    if not seg then
        seg = Instance.new("Part")
        seg.Anchored = true
        seg.CanCollide = false
        seg.CanQuery = false
        seg.CanTouch = false
        seg.CastShadow = false
        seg.Material = Enum.Material.Neon
        seg.Transparency = 1
        seg.Parent = data.folder
        data.segments[index] = seg
    end
    return seg
end

local function hideArc(data)
    for _, seg in ipairs(data.segments) do
        seg.Transparency = 1
    end
end

local function drawArc(data, points)
    local used = 0
    local i = 1
    while i < #points do
        local j = math.min(i + ARC_STRIDE, #points)
        used += 1

        local a, b = points[i], points[j]
        local length = (b - a).Magnitude
        local seg = getSegment(data, used)

        if length > 0.01 and not (ARC_DASHED and used % 2 == 0) then
            seg.Size = Vector3.new(ARC_THICKNESS, ARC_THICKNESS, length)
            seg.CFrame = CFrame.lookAt((a + b) / 2, b)
            seg.Color = markerColor
            seg.Transparency = ARC_TRANSPARENCY
        else
            seg.Transparency = 1
        end

        i = j
    end

    for k = used + 1, #data.segments do
        data.segments[k].Transparency = 1
    end
end

local function hideVisuals(data)
    data.marker.Transparency = 1
    data.highlight.Adornee = nil
    hideArc(data)
end

local function hideBall(data)
    data.landing = nil
    hideVisuals(data)
end

local function hideAll()
    for _, data in pairs(balls) do
        hideVisuals(data)
    end
end

local function setMarkerColor(color)
    markerColor = color
    for _, data in pairs(balls) do
        data.marker.Color = color
        data.highlight.FillColor = color
    end
end

---------------------------------------------------------------------
-- Predictor: prediction
---------------------------------------------------------------------
local skipped = setmetatable({}, { __mode = "k" })
local rayParams

local function buildRayParams()
    local ignore = { markerFolder, arcFolder, highlightFolder }
    for inst in pairs(balls) do
        table.insert(ignore, inst)
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then table.insert(ignore, plr.Character) end
    end
    for part in pairs(skipped) do
        table.insert(ignore, part)
    end

    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = ignore
    p.RespectCanCollide = true
    return p
end

local function getRadius(data, part)
    if not USE_SPHERECAST then return 0 end
    local size = data.inst:IsA("Model") and data.inst:GetExtentsSize() or part.Size
    return math.min(size.X, size.Y, size.Z) / 2
end

local function castSegment(from, to, radius)
    local dir = to - from
    for _ = 1, 6 do
        local hit
        if radius > 0.05 then
            hit = Workspace:Spherecast(from, radius * 0.95, dir, rayParams)
        else
            hit = Workspace:Raycast(from, dir, rayParams)
        end
        if not hit then return nil end

        local part = hit.Instance
        if IGNORE_INVISIBLE and part.Transparency >= INVISIBLE_THRESHOLD then
            skipped[part] = true
            rayParams = buildRayParams()
        else
            return hit
        end
    end
    return nil
end

local function predictLanding(pos, vel, radius, gravity)
    local points = { pos }
    local t = 0
    while t < MAX_TIME do
        local newPos = pos + vel * STEP + 0.5 * gravity * STEP * STEP
        local move = newPos - pos
        if move.Magnitude < 1e-4 then break end

        local hit = castSegment(pos, newPos, radius)
        if hit then
            table.insert(points, pos + move.Unit * hit.Distance)
            return hit.Position, points
        end
        table.insert(points, newPos)
        vel = vel + gravity * STEP
        pos = newPos
        t += STEP
    end
    return nil, points
end

---------------------------------------------------------------------
-- Predictor: motion tracking
---------------------------------------------------------------------
local function fitMotion(history, gravity)
    local n = #history
    if n < MIN_SAMPLES then return nil end

    local tLast = history[n].t
    if tLast - history[1].t < 0.06 then return nil end

    local sT, sTT = 0, 0
    local sY, sTY = Vector3.zero, Vector3.zero
    for _, s in ipairs(history) do
        local tau = s.t - tLast
        local y = s.pos - 0.5 * gravity * tau * tau
        sT += tau
        sTT += tau * tau
        sY += y
        sTY += y * tau
    end

    local denom = n * sTT - sT * sT
    if denom < 1e-9 then return nil end

    local vel = (sTY * n - sY * sT) / denom
    local pos = (sY - vel * sT) / n
    return pos, vel
end

local function updateMotion(data, part, gravity)
    local now = os.clock()
    local history = data.history
    local pos = part.Position
    local bounced = false

    if data.fitPos then
        local tau = now - data.fitTime
        local expected = data.fitPos + data.fitVel * tau + 0.5 * gravity * tau * tau
        local allowed = RESET_ERROR + data.fitVel.Magnitude * 0.06
        if (pos - expected).Magnitude > allowed then
            table.clear(history)
            data.fitPos = nil
            bounced = true
        end
    end

    table.insert(history, { t = now, pos = pos })
    while #history > 2 and now - history[1].t > SAMPLE_WINDOW do
        table.remove(history, 1)
    end

    local fitPos, fitVel = fitMotion(history, gravity)
    if fitPos then
        data.fitPos, data.fitVel, data.fitTime = fitPos, fitVel, now
        return fitPos, fitVel, bounced
    end

    data.fitPos = nil
    return pos, part.AssemblyLinearVelocity, bounced
end

RunService.Heartbeat:Connect(function(dt)
    rayParams = buildRayParams()
    local gravity = Vector3.new(0, -(GRAVITY_OVERRIDE or Workspace.Gravity), 0)

    for inst, data in pairs(balls) do
        local part = getPart(data)

        if not part then
            table.clear(data.history)
            data.fitPos = nil
            hideBall(data)
        else
            local pos, vel, bounced = updateMotion(data, part, gravity)
            local radius = getRadius(data, part)

            if not data.dead then
                local last = data.landing
                if last then
                    local away = (pos - last).Magnitude
                    if away < radius + LAND_TOUCH or (bounced and away < DEAD_DISTANCE) then
                        data.dead = true
                    end
                end
            end

            if data.dead then
                hideBall(data)
            else
                local landing, points = predictLanding(pos, vel, radius, gravity)

                if landing then
                    local prev = data.landing
                    if prev and (landing - prev).Magnitude < SNAP_DISTANCE then
                        landing = prev:Lerp(landing, 1 - math.exp(-SMOOTHING * dt))
                    end
                    data.landing = landing
                else
                    data.landing = nil
                end

                if enabled and landing then
                    data.marker.Transparency = 0.35
                    data.marker.CFrame = CFrame.new(landing + Vector3.new(0, 0.1, 0))
                        * CFrame.Angles(0, 0, math.rad(90))
                else
                    data.marker.Transparency = 1
                end

                if enabled then
                    data.highlight.Adornee = inst
                    if arcEnabled then
                        drawArc(data, points)
                    else
                        hideArc(data)
                    end
                else
                    data.highlight.Adornee = nil
                    hideArc(data)
                end
            end
        end
    end
end)

---------------------------------------------------------------------
-- Walk to ball & Action Trigger (Rotation, Key 3, & Spam Sprint)
---------------------------------------------------------------------
local function getGoal(data)
    if data.dead then return nil end
    local part = getPart(data)
    if not part then return nil end
    return data.landing or part.Position
end

local function findBall()
    local best, bestDist = nil, math.huge
    local myRoot = root
    if not myRoot then return nil end

    for _, data in pairs(balls) do
        local goal = getGoal(data)
        if goal then
            local offset = goal - myRoot.Position
            offset = Vector3.new(offset.X, 0, offset.Z)
            local dist = offset.Magnitude

            if dist > 0.1 and dist <= walkRange and dist < bestDist then
                local side = offset.Unit:Dot(myRoot.CFrame.RightVector)
                local ok = walkSide == "Any"
                    or (walkSide == "Right" and side >= SIDE_THRESHOLD)
                    or (walkSide == "Left" and -side >= SIDE_THRESHOLD)
                if ok then
                    best, bestDist = data, dist
                end
            end
        end
    end
    return best
end

local function stopMoving()
    runId += 1
    if humanoid and root then
        humanoid:MoveTo(root.Position)
    end
end

local function simulateKeyPress(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function walkTo(data)
    runId += 1
    local myId = runId
    local startTime = os.clock()
    local lastCommand = 0
    local lastSpamTime = 0
    local lastGoal
    local actionFired = false

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if runId ~= myId or not humanoid or humanoid.Health <= 0 or not root or balls[data.inst] ~= data then
            conn:Disconnect()
            return
        end

        local goal = getGoal(data) or lastGoal
        if not goal then
            conn:Disconnect()
            return
        end
        lastGoal = goal

        local offset = goal - root.Position
        local flatDist = Vector3.new(offset.X, 0, offset.Z).Magnitude

        -- Continuous key / sprint spam loop while walking
        if SPAM_ENABLED and os.clock() - lastSpamTime >= SPAM_INTERVAL then
            lastSpamTime = os.clock()
            VirtualInputManager:SendKeyEvent(true, SPAM_KEY, false, game)
            task.spawn(function()
                task.wait(0.02)
                VirtualInputManager:SendKeyEvent(false, SPAM_KEY, false, game)
            end)
        end

        -- Trigger condition: rotate character to look at target and send key "3" when close enough
        if flatDist <= TRIGGER_DISTANCE and not actionFired then
            if FIRE_ONCE_PER_TRIP then
                actionFired = true
            end

            -- Snap orientation horizontally (Yaw only) toward the target goal/marker
            local lookTarget = Vector3.new(goal.X, root.Position.Y, goal.Z)
            root.CFrame = CFrame.lookAt(root.Position, lookTarget)

            -- Send virtual input press for Key "3"
            simulateKeyPress(ACTION_KEY)
        end

        -- Arrived, or took too long
        if flatDist <= walkStop or os.clock() - startTime > GIVE_UP_TIME then
            conn:Disconnect()
            humanoid:MoveTo(root.Position)
            return
        end

        -- MoveTo re-issued periodically to handle moving landing predictions
        if os.clock() - lastCommand > 0.25 then
            lastCommand = os.clock()
            humanoid:MoveTo(goal)
        end
    end)
end

local function startWalk()
    if not walkEnabled then return end
    if not (humanoid and root) or humanoid.Health <= 0 then return end

    local data = findBall()
    if data then
        walkTo(data)
    end
end

UserInputService.InputBegan:Connect(function(input, processed)
    -- Global Hotkey to Toggle UI Visibility
    if input.KeyCode == UI_TOGGLE_KEY then
        if mainGuiReference then
            mainGuiReference.Enabled = not mainGuiReference.Enabled
        end
        return
    end

    if listeningForKey then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            listeningForKey = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                triggerKey = input.KeyCode
            end
            if refreshKeyButton then refreshKeyButton() end
        end
        return
    end

    if processed or input.KeyCode ~= triggerKey then return end
    startWalk()
end)

