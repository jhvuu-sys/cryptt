        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.new(1, 1, 1)
        label.Font = header and Enum.Font.GothamBold or Enum.Font.GothamMedium
        label.TextSize = header and 14 or 13
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame
        return label
    end

    local function makeButton(text, x, y, w, h)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, w, 0, h)
        btn.Position = UDim2.new(0, x, 0, y)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
        btn.BorderSizePixel = 0
        btn.Text = text
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 12
        btn.Parent = frame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
        return btn
    end

    local function makeStepper(y, get, set, step, min, max)
        local minus = makeButton("-", 110, y, 24, 24)
        local plus = makeButton("+", 186, y, 24, 24)

        local value = Instance.new("TextLabel")
        value.Size = UDim2.new(0, 48, 0, 24)
        value.Position = UDim2.new(0, 136, 0, y)
        value.BackgroundTransparency = 1
        value.TextColor3 = Color3.new(1, 1, 1)
        value.Font = Enum.Font.GothamMedium
        value.TextSize = 13
        value.Parent = frame

        local function change(delta)
            local new = math.clamp(get() + delta, min, max)
            set(math.floor(new * 10 + 0.5) / 10)
            value.Text = tostring(get())
        end
        minus.Activated:Connect(function() change(-step) end)
        plus.Activated:Connect(function() change(step) end)
        value.Text = tostring(get())
    end

    makeLabel("Auto Walk", 182, true)

    local walkToggleBtn = Instance.new("TextButton")
    walkToggleBtn.Size = UDim2.new(0, 60, 0, 24)
    walkToggleBtn.Position = UDim2.new(1, -70, 0, 182)
    walkToggleBtn.Font = Enum.Font.GothamBold
    walkToggleBtn.TextSize = 12
    walkToggleBtn.TextColor3 = Color3.new(1, 1, 1)
    walkToggleBtn.Parent = frame
    Instance.new("UICorner", walkToggleBtn).CornerRadius = UDim.new(0, 5)
    styleToggle(walkToggleBtn, walkEnabled)

    walkToggleBtn.Activated:Connect(function()
        walkEnabled = not walkEnabled
        styleToggle(walkToggleBtn, walkEnabled)
        if not walkEnabled then stopMoving() end
    end)

    makeLabel("Side", 218)
    local sideBtn = makeButton(walkSide, 110, 218, 100, 24)
    sideBtn.Activated:Connect(function()
        walkSide = (walkSide == "Right" and "Left") or (walkSide == "Left" and "Any") or "Right"
        sideBtn.Text = walkSide
    end)

    makeLabel("Range", 250)
    makeStepper(250, function() return walkRange end, function(v) walkRange = v end, 5, 5, 200)

    makeLabel("Stop dist.", 282)
    makeStepper(282, function() return walkStop end, function(v) walkStop = v end, 0.5, 0, 10)

    makeLabel("Key", 314)
    local keyBtn = makeButton(triggerKey.Name, 110, 314, 100, 24)
    refreshKeyButton = function()
        keyBtn.Text = triggerKey.Name
    end
    keyBtn.Activated:Connect(function()
        listeningForKey = true
        keyBtn.Text = "Press a key..."
    end)

    local walkNowBtn = makeButton("Walk Now", 10, 348, 210, 28)
    walkNowBtn.BackgroundColor3 = Color3.fromRGB(60, 110, 200)
    walkNowBtn.Activated:Connect(startWalk)

    -- 2) Secondary Action Config Panel (Trigger Distance for Key 3)
    local actionFrame = Instance.new("Frame")
    actionFrame.Size = UDim2.new(0, 230, 0, 80)
    actionFrame.Position = UDim2.new(0, 260, 0.5, -194)
    actionFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 34)
    actionFrame.BorderSizePixel = 0
    actionFrame.Active = true
    actionFrame.Draggable = true
    actionFrame.Parent = gui
    Instance.new("UICorner", actionFrame).CornerRadius = UDim.new(0, 8)

    local actionTitle = Instance.new("TextLabel")
    actionTitle.Size = UDim2.new(1, -20, 0, 24)
    actionTitle.Position = UDim2.new(0, 10, 0, 8)
    actionTitle.BackgroundTransparency = 1
    actionTitle.Text = "Action Config (Key 3)"
    actionTitle.TextColor3 = Color3.new(1, 1, 1)
    actionTitle.Font = Enum.Font.GothamBold
    actionTitle.TextSize = 13
    actionTitle.TextXAlignment = Enum.TextXAlignment.Left
    actionTitle.Parent = actionFrame

    local distLbl = Instance.new("TextLabel")
    distLbl.Size = UDim2.new(0, 120, 0, 24)
    distLbl.Position = UDim2.new(0, 10, 0, 40)
    distLbl.BackgroundTransparency = 1
    distLbl.Text = "Trigger Dist."
    distLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    distLbl.Font = Enum.Font.GothamMedium
    distLbl.TextSize = 13
    distLbl.TextXAlignment = Enum.TextXAlignment.Left
    distLbl.Parent = actionFrame

    local distBox = Instance.new("TextBox")
    distBox.Size = UDim2.new(0, 80, 0, 24)
    distBox.Position = UDim2.new(1, -90, 0, 40)
    distBox.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
    distBox.BorderSizePixel = 0
    distBox.Text = tostring(TRIGGER_DISTANCE)
    distBox.TextColor3 = Color3.new(1, 1, 1)
    distBox.Font = Enum.Font.Gotham
    distBox.TextSize = 13
    distBox.ClearTextOnFocus = false
    distBox.Parent = actionFrame
    Instance.new("UICorner", distBox).CornerRadius = UDim.new(0, 5)

    distBox.FocusLost:Connect(function()
        val, num = nil, tonumber(distBox.Text)
        if num then
            TRIGGER_DISTANCE = num
        else
            distBox.Text = tostring(TRIGGER_DISTANCE)
        end
    end)
end

createPanel()
print("Combined Script with UI Toggle Hotkey Loaded Successfully!")
